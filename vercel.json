{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(images|assets|css|js)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_KEY": "base64:wt7oKBsUnnxV8KcSp6fi+DPqi6vKlPEVvdGAb053fU8=",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "APP_MAINTENANCE_DRIVER": "file",
        "APP_MAINTENANCE_STORE": "database",
        "VIEW_COMPILED_PATH": "/tmp",
        "LOG_CHANNEL": "stderr",
        "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php",
        "APP_CONFIG_CACHE": "/tmp/storage/bootstrap/cache/config.php",
        "APP_ROUTES_CACHE": "/tmp/storage/bootstrap/cache/routes.php",
        "APP_EVENTS_CACHE": "/tmp/storage/bootstrap/cache/events.php"
    }
}
